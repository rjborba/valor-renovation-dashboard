{
  "name": "valor",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:dashboard": "turbo run dev --filter=dashboard",
    "dev:tasks": "turbo run dev --filter=tasks",
    "dev:reports": "turbo run dev --filter=reports",
    "build:local": "turbo run build:local",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"packages/**/*.test.ts\" \"apps/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "deploy:tasks": "npm run deploy --workspace tasks",
    "deploy:reports": "npm run deploy --workspace reports",
    "deploy:dashboard": "npm run deploy --workspace dashboard",
    "deploy": "npm run deploy:tasks && npm run deploy:reports && npm run deploy:dashboard"
  },
  "devDependencies": {
    "@module-federation/enhanced": "2.9.3",
    "@playwright/test": "1.65.1",
    "@rspack/cli": "2.3.3",
    "@rspack/core": "2.3.3",
    "@rspack/dev-server": "2.2.2",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "turbo": "2.11.13",
    "typescript": "6.0.3",
    "zephyr-rspack-plugin": "1.8.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.12.1"
}
